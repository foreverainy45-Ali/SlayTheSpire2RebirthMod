<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SeedRestart</AssemblyName>
    <Version>0.4.1</Version>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">I:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2Dir>
    <GameLib>$(Sts2Dir)\data_sts2_windows_x86_64</GameLib>
    <JmcModLibDir Condition="'$(JmcModLibDir)' == ''">I:\SteamLibrary\steamapps\workshop\content\2868840\3747526103</JmcModLibDir>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefineConstants Condition="'$(RuntimeProbe)' == 'true'">$(DefineConstants);RUNTIME_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameLib)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameLib)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameLib)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="JmcModLib"><HintPath>$(JmcModLibDir)\JmcModLib.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="..\SeedRestart.Core\RestartBallot.cs" Link="Core\RestartBallot.cs" />
    <Compile Include="..\SeedRestart.Core\QuoteCatalog.cs" Link="Core\QuoteCatalog.cs" />
    <None Update="SeedRestart.quotes.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
